# Copy this file to .env and fill in your own values.
# .env is git-ignored — never commit real secrets.

# Postgres connection string
# Local (docker compose): postgresql://techhire:localdev@localhost:5433/techhire_db
DATABASE_URL=postgresql://username:password@localhost:5432/techhire

# Free key from https://console.groq.com — powers AI job summaries and resume analysis
GROQ_API_KEY=your_groq_api_key

# RapidAPI key for the JSearch API (https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch)
# powers the Indeed/Glassdoor/Handshake/Lever scrapers. Only needed to run `python main.py`.
RAPIDAPI_KEY=your_rapidapi_key

# Redis connection string. Optional — if unreachable, the app disables
# caching/rate-limiting automatically instead of failing.
# Local (docker compose): redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# Optional. When set, POST /scrape/refresh requires header `X-Admin-Key: <this value>`.
# Leave unset for local dev to use the refresh button freely.
ADMIN_API_KEY=

# Comma-separated list of origins allowed to call the API (CORS).
# Add your deployed frontend URL here once you deploy (see DEPLOYMENT.md).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
